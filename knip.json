{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/polyfills/*.js!", "scripts/check-contract-changes.mjs!"],
  "project": ["src/**/*.{js,jsx,ts,tsx,sass,scss}!", "scripts/**/*.{js,mjs}!"],
  "include": ["unlisted", "unresolved", "binaries", "duplicates", "cycles"],
  "ignoreBinaries": ["rustc", "cc"],
  "ignoreDependencies": ["lint-staged"],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"],
    "src/services/bindings.ts": ["types"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
